# Copy to desk/.env.local for local dev (git-ignored). The Pages workflow sets
# these from repository variables DESK_SCRIPT_ID / DESK_GOOGLE_CLIENT_ID.
#
# The EXP script id (docs/dev-environment.md "EXPERIMENTAL"): the only script
# with an "API executable" deployment. Calls run AS THE SIGNED-IN USER through
# the Apps Script Execution API (scripts.run).
VITE_SCRIPT_ID=1P8oMEhR0xpljFLCGnzEJQRGSs38aju2VUiUy0HIj3imB-Hopt26hD3Ha
# Web OAuth client id, created in the SAME Google Cloud project the EXP script
# is linked to (Apps Script API enabled there). Authorized JavaScript origins
# must list the Pages origin and http://localhost:5173. Public by design.
VITE_GOOGLE_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com
# true = run the script's HEAD (owner/editors only; no version bump needed
# while iterating). false = the API-executable deployment's version.
VITE_DEV_MODE=true
