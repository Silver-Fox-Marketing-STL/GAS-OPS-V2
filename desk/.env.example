# Copy to desk/.env.local for local dev (git-ignored). The Pages workflow sets
# these from repository variables DESK_EXEC_URL / DESK_GOOGLE_CLIENT_ID.
#
# The EXP /exec URL (docs/dev-environment.md "EXPERIMENTAL"): the only script
# whose ENV_IDS entry has apiEnabled: true. PROD and DEV refuse the API.
VITE_EXEC_URL=https://script.google.com/macros/s/AKfycbzE7vg5xz-75kxmhskxidN58anS8nHM_Nvc5vuHKew5q8IBeRwJP607nag63tEdTtsf/exec
# Web OAuth client id (Google Cloud console). Authorized JavaScript origins must
# list the Pages origin and http://localhost:5173. Public by design (not a secret);
# the server checks that every token's `aud` equals API_OAUTH_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com
