<mxfile host="app.diagrams.net">
  <diagram name="GAS ShortCut OPS Architecture" id="gasops-arch">
    <mxGraphModel dx="1200" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageWidth="1500" pageHeight="1050" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===== Title ===== -->
        <mxCell id="title" value="GAS ShortCut OPS 1.0 — Vehicle Graphic Production System" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="360" y="10" width="700" height="30" as="geometry" />
        </mxCell>

        <!-- ===== Actors / external inputs (top) ===== -->
        <mxCell id="user" value="Operator&#10;(Nick / staff)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="330" width="40" height="80" as="geometry" />
        </mxCell>

        <mxCell id="scraper" value="Scraper Inventory Feed&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;CSV export, one or more files&lt;/font&gt;" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="150" y="60" width="220" height="100" as="geometry" />
        </mxCell>

        <!-- ===== Google Apps Script boundary ===== -->
        <mxCell id="gasBox" value="Google Apps Script&#160;&#160;·&#160;&#160;bound to SF_SYSTEM_MASTER" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontStyle=1;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="300" y="220" width="760" height="320" as="geometry" />
        </mxCell>

        <mxCell id="app" value="SilverFox App&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;App.html SPA · sidebar nav · view fragments&lt;br&gt;Run · Import · VIN Logs · Rules · Norm&lt;br&gt;Transcription · Home · Utilities · PD Settings&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="330" y="270" width="300" height="120" as="geometry" />
        </mxCell>

        <mxCell id="code" value="Code.gs backend&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;~7,160 lines · run pipeline · import (2-phase)&lt;br&gt;CAO pre-fill · stats / dashboard&lt;br&gt;QR · CSV · billing generation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="700" y="270" width="320" height="120" as="geometry" />
        </mxCell>

        <mxCell id="engine" value="Normalization + Filtering / Targeting engine&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;fail-safe rules · billing / source split&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="330" y="430" width="300" height="80" as="geometry" />
        </mxCell>

        <mxCell id="pdint" value="Pipedrive Integration (Section 31)&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;deals · products · install cost · billing PDF&lt;br&gt;never-throw pdFetch_ · idempotent&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="700" y="430" width="320" height="80" as="geometry" />
        </mxCell>

        <!-- ===== External APIs (right) ===== -->
        <mxCell id="qrapi" value="QR Code API&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;UrlFetchApp.fetchAll&lt;br&gt;(batch)&lt;/font&gt;" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1140" y="250" width="200" height="100" as="geometry" />
        </mxCell>

        <mxCell id="pdapi" value="Pipedrive CRM API&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;deals · products · /files&lt;br&gt;secrets in ScriptProperties&lt;/font&gt;" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1140" y="410" width="200" height="100" as="geometry" />
        </mxCell>

        <!-- ===== Core spreadsheets boundary ===== -->
        <mxCell id="sheetsBox" value="Google Sheets&#160;&#160;·&#160;&#160;Core Spreadsheets (Drive)" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontStyle=1;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="100" y="600" width="1260" height="190" as="geometry" />
        </mxCell>

        <mxCell id="master" value="SF_SYSTEM_MASTER&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;(script-bound)&lt;br&gt;SCRAPERDATA · ORDERS · RUN_LOG&lt;br&gt;IMPORT / ORDER / TYPE_STATS&lt;br&gt;DASHBOARD · TRANSCRIPTION&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="130" y="640" width="260" height="130" as="geometry" />
        </mxCell>

        <mxCell id="config" value="SF_DEALER_CONFIG&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;DEALERS · NORM_MAPS · CSV_SCHEMAS&lt;br&gt;PIPEDRIVE · PIPEDRIVE_SETTINGS&lt;br&gt;USER_PROFILES · FIELD_CODES&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="440" y="640" width="260" height="130" as="geometry" />
        </mxCell>

        <mxCell id="template" value="SF_UNIVERSAL_TEMPLATE&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;copied per order → output doc&lt;br&gt;ORDERMATCH · LINKBUILDER&lt;br&gt;CSV · BILLING · LOG&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="750" y="640" width="260" height="130" as="geometry" />
        </mxCell>

        <mxCell id="vinlogs" value="SF_VIN_LOGS&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;one tab per dealer_key&lt;br&gt;ORDER_ID · VIN · committed_at&lt;br&gt;CAO dedup source of truth&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1060" y="640" width="260" height="130" as="geometry" />
        </mxCell>

        <!-- ===== Outputs (bottom) ===== -->
        <mxCell id="outfolder" value="Drive Output Folders&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;per-dealer: output doc + QR Codes/&lt;/font&gt;" style="shape=folder;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="320" y="860" width="280" height="110" as="geometry" />
        </mxCell>

        <mxCell id="local" value="Local Workstation&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;QR PNGs (USER_PROFILES path) + exported CSV&lt;br&gt;→ Adobe Illustrator (variable-data print)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="760" y="860" width="320" height="110" as="geometry" />
        </mxCell>

        <!-- ===== Edges ===== -->
        <mxCell id="e_user_app" value="uses" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" parent="1" source="user" target="app"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_scr_app" value="CSV import" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" parent="1" source="scraper" target="app"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_app_code" value="google.script.run" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;startArrow=classic;endArrow=classic;" edge="1" parent="1" source="app" target="code"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_code_eng" style="edgeStyle=orthogonalEdgeStyle;html=1;startArrow=classic;endArrow=classic;" edge="1" parent="1" source="code" target="engine"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_code_pdint" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="code" target="pdint"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e_code_qr" value="generate QR (async batch)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;dashed=1;" edge="1" parent="1" source="code" target="qrapi"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_pd_api" value="push deal (REST)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;dashed=1;" edge="1" parent="1" source="pdint" target="pdapi"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e_code_master" value="read / write&#10;inventory · orders · logs" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;startArrow=classic;endArrow=classic;" edge="1" parent="1" source="code" target="master"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_code_config" value="read config" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" parent="1" source="code" target="config"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_code_tmpl" value="copy per order" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" parent="1" source="code" target="template"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_code_vin" value="CAO dedup · commit" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;startArrow=classic;endArrow=classic;" edge="1" parent="1" source="code" target="vinlogs"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e_tmpl_out" value="output doc" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" parent="1" source="template" target="outfolder"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_qr_out" value="QR PNGs" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" parent="1" source="qrapi" target="outfolder">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="1240" y="930" /><mxPoint x="640" y="930" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_out_local" value="download + export" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;" edge="1" parent="1" source="outfolder" target="local"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ===== Legend ===== -->
        <mxCell id="legend" value="Legend" style="swimlane;whiteSpace=wrap;html=1;startSize=22;fillColor=none;strokeColor=#999999;fontStyle=1;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="1140" y="600" width="220" height="170" as="geometry" />
        </mxCell>
        <mxCell id="lg1" value="App / backend logic" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="legend"><mxGeometry x="10" y="30" width="120" height="22" as="geometry" /></mxCell>
        <mxCell id="lg2" value="Engine / integration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;" vertex="1" parent="legend"><mxGeometry x="10" y="58" width="120" height="22" as="geometry" /></mxCell>
        <mxCell id="lg3" value="Data store (Sheet)" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=9;" vertex="1" parent="legend"><mxGeometry x="10" y="86" width="40" height="34" as="geometry" /></mxCell>
        <mxCell id="lg4" value="External system" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;" vertex="1" parent="legend"><mxGeometry x="10" y="128" width="60" height="34" as="geometry" /></mxCell>
        <mxCell id="lg5" value="solid = sync · dashed = async/external" style="text;html=1;fontSize=9;align=left;fontColor=#666666;" vertex="1" parent="legend"><mxGeometry x="80" y="130" width="135" height="30" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
