# Files that must NOT be pushed to Apps Script. clasp ignores these like .gitignore
# (clasp does NOT read .gitignore). The Apps Script project is Code.gs + the *.html
# views + appsscript.json at the repo root; everything below is local-only tooling/docs.

# Local doc-PDF builder — Node.js (ES modules). Pushing its .js as .gs breaks `clasp push`
# with "Cannot use import statement outside a module" (e.g. scripts/node_modules/marked).
scripts/**
**/node_modules/**
node_modules/**

# Docs + repo meta (never Apps Script source)
docs/**
**/*.md
.git/**

# Visual-brainstorming companion scratch (local-only mockups; never Apps Script source)
.superpowers/**

# Standalone Lot Scanner — its OWN Apps Script project (lot-scan/.clasp.json), pushed
# separately from inside lot-scan/. Must NOT be pushed into the main project or its
# Code.gs / SharedUtils.html would collide (Apps Script's file namespace is flat).
lot-scan/**

# Standalone EOM Report Viewer — its OWN Apps Script project (eom-viewer/.clasp.json),
# pushed separately from inside eom-viewer/. Excluded here so its Code.gs / Viewer.html /
# EomReportRenderer.html copy never collides with the main project (flat namespace).
eom-viewer/**
